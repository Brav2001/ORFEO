---
import "../styles/index.css";
const { title } = Astro.props;

import { ViewTransitions } from "astro:transitions";

import Navbar from "../components/SiteComponents/Navbar.jsx";
import Footer from "../components/SiteComponents/Footer.astro";
---

<!doctype html>
<html lang="es" class="h-full w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="canonical" href="https://funigualdadh.org" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Sitio web de la Fundación para la igualdad y el desarrollo humano Funigualdadh."
    />
    <title>{title}</title>
    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://funigualdadh.org/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Sitio web de la Fundación para la igualdad y el desarrollo humano Funigualdadh."
    />
    <meta property="og:image" content="/jb_logo.svg" />
    <meta property="og:image:alt" content="logo Funigualdadh" />
    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="funigualdadh.org" />
    <meta property="twitter:url" content="https://funigualdadh.org/" />
    <meta name="twitter:title" content="Funigualdadh.org" />
    <meta
      name="twitter:description"
      content="Sitio web de la Fundación para la igualdad y el desarrollo humano Funigualdadh."
    />
    <meta name="twitter:image" content="/jb_logo.svg" />

    <link rel="apple-touch-icon" sizes="180x180" href="/jb_logo.svg" />
    <link rel="icon" type="image/x-icon" href="/jb_logo.svg" />

    <ViewTransitions />
  </head>

  <body>
    <header>
      <Navbar client:only transition:persist />
    </header>
    <div class="min-h-screen">
      <slot />
    </div>
    <div>
      <Footer />
    </div>
  </body>
</html>
