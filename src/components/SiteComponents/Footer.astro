---
import { Icon } from "astro-icon/components";
---

<section class="footer-section">

  <div class="wave">
    <svg viewBox="0 0 1440 150" preserveAspectRatio="none">
      <path d="M0,80 C360,150 1080,0 1440,80 L1440,0 L0,0 Z" fill="white"></path>
    </svg>
  </div>

  <p class="footer-text">
    “Recibimos servicios de alta calidad que mejoraron nuestro modelo
    financiero y nuestras prácticas organizativas.”
  </p>

  <div class="social-icons">
    <a href="https://instagram.com/tuusuario" target="_blank">
      <Icon name="mdi:instagram" />
    </a>

    <a href="https://wa.me/3160435877" target="_blank">
      <Icon name="mdi:whatsapp" />
    </a>

    <a href="https://linkedin.com/in/tuusuario" target="_blank">
      <Icon name="mdi:linkedin" />
    </a>
</div>

</section>
<style>
  .footer-section {
    position: relative;
    background: #3333;
    padding: 120px 20px 60px;
    text-align: center;
    overflow: hidden;
  }

  .wave {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 120px;
  }

  .wave svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .footer-text {
    max-width: 700px;
    margin: auto;
    font-size: 18px;
    line-height: 1.6;
    color: #000;
  }

  .social-icons {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 25px;
  }

  .social-icons a {
    font-size: 28px;
    color: black;
    transition: 0.3s;
  }

  .social-icons a:hover {
    transform: translateY(-4px);
    opacity: 0.7;
  }

</style>